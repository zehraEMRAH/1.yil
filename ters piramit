#include <stdio.h>
#include <stdlib.h>

int main()
{
    int x,y,z;
    printf("ters piramit kac satirli olsun=\t");
    scanf("%d",&z);
    for(x=z;x>0;x--){
        for(y=0;y<z-x;y++){
            printf(" ");
        }
        for(y=0;y<x;y++){
            printf("* ");
        }printf("\n");
    }
    return 0;
}
