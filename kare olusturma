#include <stdio.h>
#include <stdlib.h>

int main()
{
    int x;
    int y;
    int z;
    printf("kac birimlik kare istersiniz=\t");
    scanf("%d",&z);
     for(x=1;x<=z;x++){
        for(y=1;y<=z;y++){
            if(x==1 || x==z ||y==1 ||y==z){
                printf("*");
            }else{
            printf(" ");
            }
        }printf("\n");
     }
    return 0;
}
